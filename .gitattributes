# Normalise line endings so `dart format --set-exit-if-changed` and linters
# behave the same on Windows and on Linux CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
